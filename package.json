{
  "name": "mdpreview",
  "version": "0.1.6",
  "description": "A quiet Windows desktop Markdown editor inspired by Typora.",
  "main": "out/main/index.js",
  "author": "MdPreview",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "server": "node --env-file=.env server/index.js",
    "server:dev": "node --env-file=.env --watch server/index.js",
    "server:migrate": "node --env-file=.env server/migrate.js",
    "dev:web": "vite --config vite.web.config.js",
    "build": "electron-vite build",
    "build:web": "vite build --config vite.web.config.js",
    "dist": "npm run dist:installer",
    "dist:dir": "npm run build && electron-builder --win --dir",
    "dist:installer": "npm run build && electron-builder --win nsis",
    "dist:portable": "npm run build && electron-builder --win portable",
    "dist:zip": "npm run build && electron-builder --win zip",
    "preview": "electron-vite preview",
    "preview:web": "vite preview --config vite.web.config.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1162.0",
    "@fastify/cors": "^11.4.0",
    "@fastify/multipart": "^10.1.7",
    "@fastify/static": "^10.1.10",
    "@highlightjs/cdn-assets": "^11.11.1",
    "bcryptjs": "^3.0.3",
    "dompurify": "^3.2.6",
    "fastify": "^5.12.8",
    "jsonwebtoken": "^9.0.3",
    "markdown-it": "^14.1.0",
    "markdown-it-task-lists": "^2.1.1",
    "node-cron": "^4.6.0",
    "pg": "^8.23.1",
    "vditor": "^3.11.2",
    "vue": "^3.5.33"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.6",
    "electron": "^41.3.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "vite": "^6.3.5"
  },
  "build": {
    "appId": "com.mdpreview.app",
    "productName": "MdPreview",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "build/icon.ico"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable",
        "zip"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd"
        ],
        "name": "Markdown Document",
        "description": "Markdown document",
        "role": "Editor"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
